% Studio typography overrides layout sizes, retaining the shared Inter family.
\setbeamerfont{title}{series=\bfseries,size=\fontsize{29}{32}}
\setbeamerfont{frametitle}{series=\bfseries,size=\fontsize{17}{20}}
\setbeamerfont{framesubtitle}{series=\mdseries,size=\normalsize}
\setbeamerfont{studio hero}{series=\bfseries,size=\fontsize{29}{34}}
\setbeamerfont{studio statement}{series=\bfseries,size=\fontsize{18}{23}}
\setbeamerfont{studio caption}{series=\mdseries,size=\normalsize}
\setbeamerfont{author}{series=\mdseries,size=\normalsize}
\setbeamerfont{institute}{series=\mdseries,size=\small}

\setbeamerfont{studio number}{series=\bfseries,size=\fontsize{48}{54}}
\setbeamerfont{studio statistic}{series=\bfseries,size=\fontsize{32}{36}}

% Keep short presentation copy free of automatic word hyphenation.
\hyphenpenalty=10000
\exhyphenpenalty=10000

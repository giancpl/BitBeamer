\pgfkeys{/studio/timeline/.is family,
  /studio/timeline/direction/.is choice,
  /studio/timeline/direction/horizontal/.code={\studio@verticaltimelinefalse},
  /studio/timeline/direction/vertical/.code={\studio@verticaltimelinetrue},
  /studio/timeline/steps/.is choice,
  /studio/timeline/steps/2/.code={\def\studio@steps{2}},
  /studio/timeline/steps/3/.code={\def\studio@steps{3}},
  /studio/timeline/steps/4/.code={\def\studio@steps{4}}}
\newenvironment{studiotimeline}[1][]{%
  \begingroup
  \pgfkeys{/studio/timeline/.cd,direction=horizontal,steps=3,#1}%
  \studio@itemcount=0
  \pgfmathsetmacro{\studio@step}{0.82/\studio@steps}%
  \begin{center}\begin{tikzpicture}[x=\paperwidth,y=\paperheight]
}{%
  \ifnum\studio@itemcount=\studio@steps\else
    \PackageError{bitpolito-studio}{Event count does not match steps}{Match the number of events to steps=2, 3, or 4.}%
  \fi
  \end{tikzpicture}\end{center}\endgroup
}
\newcommand{\studioevent}[2]{%
  \advance\studio@itemcount by 1
  \ifstudio@verticaltimeline
    \pgfmathsetmacro{\studio@x}{0}\pgfmathsetmacro{\studio@y}{-(\the\studio@itemcount-1)*0.20}%
    \node[anchor=north west,text=bitpolito,align=left,inner sep=0,text width=0.63\paperwidth]
      at (0.05,\studio@y+0.025) {{\bfseries #1\par}\smallskip #2};
  \else
    \pgfmathsetmacro{\studio@x}{(\the\studio@itemcount-1)*\studio@step}\def\studio@y{0}%
    \node[anchor=south,text=bitpolito,align=center,inner sep=0,
      text width=\dimexpr\studio@step\paperwidth-0.025\paperwidth\relax]
      at (\studio@x,0.05) {{\bfseries\strut #1}};
    \node[anchor=north,text=bitpolito,align=center,inner sep=0,
      text width=\dimexpr\studio@step\paperwidth-0.025\paperwidth\relax]
      at (\studio@x,-0.05) {\hyphenpenalty=10000\exhyphenpenalty=10000 #2};
  \fi
  \node[circle,fill=bitpolito,inner sep=2pt] (studio-event-\the\studio@itemcount) at (\studio@x,\studio@y) {};
  \ifnum\studio@itemcount>1
    \pgfmathtruncatemacro{\studio@previous}{\the\studio@itemcount-1}%
    \draw[studio line] (studio-event-\studio@previous) -- (studio-event-\the\studio@itemcount);
  \fi
}

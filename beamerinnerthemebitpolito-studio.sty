% Reusable full-slide layouts. All copy remains normal selectable LaTeX text.
\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[bitpolito] (current page.south west) rectangle (current page.north east);
    \begin{scope}
      \clip ([xshift=0.65\paperwidth]current page.south west) rectangle (current page.north east);
      \node[anchor=north east,inner sep=0] at (current page.north east)
        {\includegraphics[height=1.02\paperheight]{\bitpolitostudioassetpath/cover-pattern-white.pdf}};
    \end{scope}
    \node[anchor=north west,inner sep=0] at
      ([xshift=0.105\paperwidth,yshift=-0.105\paperheight]current page.north west) {%
      \includegraphics[height=0.09\paperheight]{\bitpolitoassetpath/bull-white.pdf}%
      \hspace{0.018\paperwidth}%
      \includegraphics[height=0.09\paperheight]{\bitpolitoassetpath/polito-coat-of-arms-white.pdf}};
    \node[anchor=west,text=white,inner sep=0,text width=0.51\paperwidth,align=left]
      at ([xshift=0.105\paperwidth,yshift=0.49\paperheight]current page.south west) {%
      \raggedright
      \ifx\insertauthor\@empty\else{\usebeamerfont{author}\insertauthor\par}\vspace{0.022\paperheight}\fi
      {\usebeamerfont{title}\inserttitle\par}%
      \ifx\insertsubtitle\@empty\else\vspace{0.018\paperheight}{\small\insertsubtitle\par}\fi};
    \node[anchor=south west,text=white,inner sep=0,text width=0.51\paperwidth,align=left]
      at ([xshift=0.105\paperwidth,yshift=0.13\paperheight]current page.south west) {%
      {\usebeamerfont{institute}\insertinstitute\par}%
      \ifx\insertdate\@empty\else\vspace{0.01\paperheight}{\scriptsize\insertdate\par}\fi};
  \end{tikzpicture}%
}
\setbeamertemplate{section in toc}{%
  \tikz\node[draw=bitpolito,line width=0.5pt,rounded corners=6pt,
    text width=0.32\paperwidth,minimum height=0.12\paperheight,
    inner xsep=7pt,align=left,font=\normalsize]{\inserttocsection};\par\vspace{0.025\paperheight}%
}
\newcommand{\studiotocframe}{%
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture,overlay]
      \node[anchor=west,inner sep=0,text=bitpolito,font=\usebeamerfont{frametitle}]
        at ([xshift=\studio@margin]current page.west) {Contents};
      \node[anchor=center,inner sep=0,text width=0.39\paperwidth]
        at ([xshift=0.19\paperwidth]current page.center) {\tableofcontents[hideallsubsections]};
    \end{tikzpicture}%
  \end{frame}%
}
\newcommand{\studiosectionframe}[1]{%
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture,overlay]
      \fill[bitpolito] (current page.south west) rectangle (current page.north east);
      \node[text=white,text width=0.82\paperwidth,align=center,inner sep=0]
        at (current page.center) {{\usebeamerfont{studio hero}#1\par}};
      \draw[white,line width=1pt] (current page.south) -- ([yshift=-0.11\paperheight]current page.center);
    \end{tikzpicture}%
  \end{frame}%
}
\newcommand{\studiostatementframe}[1]{%
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture,overlay]
      \draw[studio arrow] (current page.north) -- ([yshift=0.005\paperheight]current page.center);
      \node[text=bitpolito,text width=0.68\paperwidth,align=center,inner sep=0]
        at ([yshift=-0.13\paperheight]current page.center)
        {{\usebeamerfont{studio statement}#1\par}};
    \end{tikzpicture}%
  \end{frame}%
}
% The environment owns a local card counter; subsequent rows start cleanly.
\newcount\studio@cardcount
\newif\ifstudio@arrows
\pgfkeys{/studio/cards/.is family,
  /studio/cards/columns/.is choice,
  /studio/cards/columns/2/.code={\def\studio@columns{2}},
  /studio/cards/columns/3/.code={\def\studio@columns{3}},
  /studio/cards/arrows/.is if=studio@arrows}
\newenvironment{studiocards}[1][]{%
  \begingroup
  \pgfkeys{/studio/cards/.cd,columns=3,arrows=false,#1}%
  \studio@cardcount=0
  \pgfmathsetmacro{\studio@step}{0.82/\studio@columns}%
  \begin{center}\begin{tikzpicture}[x=\paperwidth,y=\paperheight]
}{%
  \ifnum\studio@cardcount=\studio@columns\else
    \PackageError{bitpolito-studio}{Card count does not match columns}{Use exactly two or three cards to match the columns option.}%
  \fi
  \end{tikzpicture}\end{center}\endgroup
}
\newsavebox{\studio@graphic}
\newcommand{\studiocard}[2]{%
  \advance\studio@cardcount by 1
  \ifnum\studio@cardcount>\studio@columns
    \PackageError{bitpolito-studio}{Too many cards}{Match the card count to columns=2 or columns=3.}%
  \fi
  \pgfmathsetmacro{\studio@x}{(\the\studio@cardcount-1)*\studio@step}%
  \sbox{\studio@graphic}{#1}%
  \ifdim\wd\studio@graphic>0.085\paperwidth
    \sbox{\studio@graphic}{\resizebox{0.085\paperwidth}{!}{\usebox{\studio@graphic}}}%
  \fi
  \ifdim\dimexpr\ht\studio@graphic+\dp\studio@graphic\relax>0.12\paperheight
    \sbox{\studio@graphic}{\resizebox{!}{0.12\paperheight}{\usebox{\studio@graphic}}}%
  \fi
  \node[studio card,inner sep=0] (studio-card-\the\studio@cardcount) at (\studio@x,0) {\usebox{\studio@graphic}};
  \node[anchor=north,inner sep=0,text width=\dimexpr\studio@step\paperwidth-0.035\paperwidth\relax,
    align=center,text=bitpolito,font=\usebeamerfont{studio caption}] at (\studio@x,-0.15) {#2};
  \ifstudio@arrows\ifnum\studio@cardcount>1
    \pgfmathtruncatemacro{\studio@previous}{\the\studio@cardcount-1}%
    \draw[studio arrow,shorten <=9pt,shorten >=9pt]
      (studio-card-\studio@previous.east) -- (studio-card-\the\studio@cardcount.west);
  \fi\fi
}
\newcommand{\studiosplitframe}[2]{%
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture,overlay]
      \fill[bitpolito] (current page.west) rectangle (current page.north east);
      \node[inner sep=0,text width=0.86\paperwidth,align=center,text=white]
        at ([yshift=0.25\paperheight]current page.center) {\color{white}#1};
      \node[inner sep=0,text width=0.86\paperwidth,align=center,text=bitpolito]
        at ([yshift=-0.25\paperheight]current page.center) {#2};
    \end{tikzpicture}%
  \end{frame}%
}
\newcommand{\studiofigureframe}[2]{%
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture,overlay]
      \node[inner sep=0,text width=0.64\paperwidth,align=center]
        at ([xshift=0.12\paperwidth]current page.center) {#2};
      \node[anchor=south west,inner sep=0,text=bitpolito,text width=0.27\paperwidth,align=left]
        at ([xshift=\studio@margin,yshift=0.14\paperheight]current page.south west)
        {{\usebeamerfont{frametitle}#1\par}};
    \end{tikzpicture}%
  \end{frame}%
}
% Match the academic command's interface while keeping the layout independent.
\pgfkeys{/studio/closing/.is family,
  /studio/closing/title/.store in=\studio@closingtitle,
  /studio/closing/subtitle/.store in=\studio@closingsubtitle,
  /studio/closing/copyright/.store in=\studio@closingcopyright}
\setbeamertemplate{closing page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[bitpolito] (current page.south west) rectangle (current page.north east);
    \node[text=white,text width=0.82\paperwidth,align=center,inner sep=0] at (current page.center) {%
      \ifx\studio@closingtitle\@empty\else{\usebeamerfont{studio hero}\studio@closingtitle\par}\fi
      \ifx\studio@closingsubtitle\@empty\else
        \ifx\studio@closingtitle\@empty\else\vspace{0.035\paperheight}\fi
        {\large\studio@closingsubtitle\par}\fi};
    \ifx\studio@closingcopyright\@empty\else
      \node[anchor=north,inner sep=0,text=white,font=\scriptsize]
        at ([yshift=-0.055\paperheight]current page.north) {\studio@closingcopyright};
    \fi
  \end{tikzpicture}%
}
\newcommand{\closingframe}[1][]{%
  \begingroup
  \pgfkeys{/studio/closing/.cd,title={Thank You!},subtitle={Questions?},
    copyright={\textcopyright{} \the\year, BitPolito},#1}%
  \begin{frame}[plain]\usebeamertemplate{closing page}\end{frame}%
  \endgroup
}

% Extended Studio components. Complete-frame commands stay independent of the
% ordinary frame background; every container scopes its options and counters.
\newsavebox{\studio@fitbox}
\newcommand{\studiofitgraphic}[3]{%
  \begingroup
  \sbox{\studio@fitbox}{#3}%
  \ifdim\wd\studio@fitbox>#1\relax
    \sbox{\studio@fitbox}{\resizebox{#1}{!}{\usebox{\studio@fitbox}}}%
  \fi
  \ifdim\dimexpr\ht\studio@fitbox+\dp\studio@fitbox\relax>#2\relax
    \sbox{\studio@fitbox}{\resizebox{!}{#2}{\usebox{\studio@fitbox}}}%
  \fi
  \usebox{\studio@fitbox}%
  \endgroup
}
\newcommand{\studioquoteframe}[2]{%
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture,overlay]
      \node[text=bitpolito,text width=0.76\paperwidth,align=left,inner sep=0]
        at (current page.center) {%
        {\usebeamerfont{studio statement}#1\par}%
        \def\studio@credit{#2}\ifx\studio@credit\@empty\else
          \vspace{0.045\paperheight}{\small #2\par}\fi};
    \end{tikzpicture}%
  \end{frame}%
}
\newcommand{\studiostatframe}[2]{%
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture,overlay]
      \fill[bitpolito] (current page.south west) rectangle (current page.north east);
      \node[text=white,text width=0.82\paperwidth,align=center,inner sep=0]
        at (current page.center) {%
        {\usebeamerfont{studio number}#1\par}%
        \vspace{0.04\paperheight}{\large #2\par}};
    \end{tikzpicture}%
  \end{frame}%
}
\newcount\studio@itemcount
\newenvironment{studiostats}[1][3]{%
  \begingroup
  \pgfkeys{/studio/cards/.cd,columns=#1}%
  \studio@itemcount=0
  \pgfmathsetmacro{\studio@step}{0.82/\studio@columns}%
  \begin{center}\begin{tikzpicture}[x=\paperwidth,y=\paperheight]
}{%
  \ifnum\studio@itemcount=\studio@columns\else
    \PackageError{bitpolito-studio}{Statistic count does not match columns}{Use two or three statistics to match the container.}%
  \fi
  \end{tikzpicture}\end{center}\endgroup
}
\newcommand{\studiostat}[2]{%
  \advance\studio@itemcount by 1
  \pgfmathsetmacro{\studio@x}{(\the\studio@itemcount-1)*\studio@step}%
  \node[inner sep=0,text=bitpolito] at (\studio@x,0) {{\usebeamerfont{studio statistic}#1}};
  \node[anchor=north,text=bitpolito,align=center,inner sep=0,
    text width=\dimexpr\studio@step\paperwidth-0.035\paperwidth\relax]
    at (\studio@x,-0.14) {#2};
}
\newenvironment{studiopanels}[1][2]{%
  \begingroup
  \pgfkeys{/studio/cards/.cd,columns=#1}%
  \studio@itemcount=0
  \pgfmathsetmacro{\studio@step}{0.86/\studio@columns}%
  \pgfmathsetmacro{\studio@panelwidth}{0.80/\studio@columns-0.04}%
  \begin{center}\begin{tikzpicture}[x=\paperwidth,y=\paperheight]
}{%
  \ifnum\studio@itemcount=\studio@columns\else
    \PackageError{bitpolito-studio}{Panel count does not match columns}{Use two or three panels to match the container.}%
  \fi
  \end{tikzpicture}\end{center}\endgroup
}
\newcommand{\studiopanel}[2]{%
  \advance\studio@itemcount by 1
  \pgfmathsetmacro{\studio@x}{(\the\studio@itemcount-1)*\studio@step}%
  \node[studio panel,anchor=north] at (\studio@x,0) {%
    \parbox[t][\studio@panelheight][t]{\studio@panelwidth\paperwidth}{%
      \raggedright{\large\bfseries #1\par}\vspace{0.025\paperheight}#2}};
}
\newif\ifstudio@imageleft
\pgfkeys{/studio/image/.is family,
  /studio/image/side/.is choice,
  /studio/image/side/left/.code={\studio@imagelefttrue},
  /studio/image/side/right/.code={\studio@imageleftfalse}}
\newcommand{\studioimageframe}[4][]{%
  \begingroup
  \pgfkeys{/studio/image/.cd,side=right,#1}%
  \ifstudio@imageleft
    \def\studio@textx{0.57}\def\studio@imagex{0.28}%
  \else
    \def\studio@textx{0.07}\def\studio@imagex{0.73}%
  \fi
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture,overlay]
      \node[anchor=west,align=left,text=bitpolito,text width=0.36\paperwidth,inner sep=0]
        at ([xshift=\studio@textx\paperwidth]current page.west) {%
        {\usebeamerfont{frametitle}\raggedright#2\par}\vspace{0.04\paperheight}\raggedright#3};
      \node[inner sep=0] at ([xshift=\studio@imagex\paperwidth]current page.west)
        {\studiofitgraphic{\studio@imagewidth}{\studio@imageheight}{#4}};
    \end{tikzpicture}%
  \end{frame}%
  \endgroup
}
\newcommand{\studiobackgroundframe}[3]{%
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture,overlay]
      \fill[bitpolito] (current page.south west) rectangle (current page.north east);
      \begin{scope}
        \clip (current page.south west) rectangle (current page.north east);
        \node[inner sep=0] at (current page.center) {#3};
      \end{scope}
      \node[studio panel,fill=studio-paper,anchor=south west,text width=0.55\paperwidth]
        at ([xshift=\studio@margin,yshift=0.12\paperheight]current page.south west) {%
        {\usebeamerfont{frametitle}#1\par}\medskip #2};
    \end{tikzpicture}%
  \end{frame}%
}
\newif\ifstudio@verticaltimeline
\pgfkeys{/studio/timeline/.is family,
  /studio/timeline/direction/.is choice,
  /studio/timeline/direction/horizontal/.code={\studio@verticaltimelinefalse},
  /studio/timeline/direction/vertical/.code={\studio@verticaltimelinetrue},
  /studio/timeline/steps/.is choice,
  /studio/timeline/steps/2/.code={\def\studio@steps{2}},
  /studio/timeline/steps/3/.code={\def\studio@steps{3}},
  /studio/timeline/steps/4/.code={\def\studio@steps{4}}}
\newenvironment{studiotimeline}[1][]{%
  \begingroup
  \pgfkeys{/studio/timeline/.cd,direction=horizontal,steps=3,#1}%
  \studio@itemcount=0
  \pgfmathsetmacro{\studio@step}{0.82/\studio@steps}%
  \begin{center}\begin{tikzpicture}[x=\paperwidth,y=\paperheight]
}{%
  \ifnum\studio@itemcount=\studio@steps\else
    \PackageError{bitpolito-studio}{Event count does not match steps}{Match the number of events to steps=2, 3, or 4.}%
  \fi
  \end{tikzpicture}\end{center}\endgroup
}
\newcommand{\studioevent}[2]{%
  \advance\studio@itemcount by 1
  \ifstudio@verticaltimeline
    \pgfmathsetmacro{\studio@x}{0}\pgfmathsetmacro{\studio@y}{-(\the\studio@itemcount-1)*0.20}%
    \node[anchor=north west,text=bitpolito,align=left,inner sep=0,text width=0.63\paperwidth]
      at (0.05,\studio@y+0.025) {{\bfseries #1\par}\smallskip #2};
  \else
    \pgfmathsetmacro{\studio@x}{(\the\studio@itemcount-1)*\studio@step}\def\studio@y{0}%
    \node[anchor=south,text=bitpolito,align=center,inner sep=0,
      text width=\dimexpr\studio@step\paperwidth-0.025\paperwidth\relax]
      at (\studio@x,0.05) {{\bfseries\strut #1}};
    \node[anchor=north,text=bitpolito,align=center,inner sep=0,
      text width=\dimexpr\studio@step\paperwidth-0.025\paperwidth\relax]
      at (\studio@x,-0.05) {\hyphenpenalty=10000\exhyphenpenalty=10000 #2};
  \fi
  \node[circle,fill=bitpolito,inner sep=2pt] (studio-event-\the\studio@itemcount) at (\studio@x,\studio@y) {};
  \ifnum\studio@itemcount>1
    \pgfmathtruncatemacro{\studio@previous}{\the\studio@itemcount-1}%
    \draw[studio line] (studio-event-\studio@previous) -- (studio-event-\the\studio@itemcount);
  \fi
}

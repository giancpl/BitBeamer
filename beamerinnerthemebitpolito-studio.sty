  \def\studio@classiccover{pattern}%
  \ifx\studio@covervariant\studio@classiccover
    \begin{frame}[plain]\titlepage\end{frame}%
  \else
    \expandafter\studio@cataloguecover\expandafter{\studio@covervariant}%
  \fi
  \endgroup
}

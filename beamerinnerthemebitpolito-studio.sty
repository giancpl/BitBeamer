% The environment owns a local card counter; subsequent rows start cleanly.
\newcount\studio@cardcount
\newif\ifstudio@arrows
\pgfkeys{/studio/cards/.is family,
  /studio/cards/columns/.is choice,
  /studio/cards/columns/2/.code={\def\studio@columns{2}},

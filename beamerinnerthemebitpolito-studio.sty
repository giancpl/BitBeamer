  /studio/cards/arrows/.is if=studio@arrows}
\newenvironment{studiocards}[1][]{%
  \begingroup
  \pgfkeys{/studio/cards/.cd,columns=3,arrows=false,#1}%
  \studio@cardcount=0
  \pgfmathsetmacro{\studio@step}{0.82/\studio@columns}%
  \begin{center}\begin{tikzpicture}[x=\paperwidth,y=\paperheight]
}{%
  \ifnum\studio@cardcount=\studio@columns\else
    \PackageError{bitpolito-studio}{Card count does not match columns}{Use exactly two or three cards to match the columns option.}%
  \fi
  \end{tikzpicture}\end{center}\endgroup
}
\newsavebox{\studio@graphic}
\newcommand{\studiocard}[2]{%
  \advance\studio@cardcount by 1
  \ifnum\studio@cardcount>\studio@columns
    \PackageError{bitpolito-studio}{Too many cards}{Match the card count to columns=2 or columns=3.}%
  \fi
  \pgfmathsetmacro{\studio@x}{(\the\studio@cardcount-1)*\studio@step}%
  \sbox{\studio@graphic}{#1}%
  \ifdim\wd\studio@graphic>0.085\paperwidth
    \sbox{\studio@graphic}{\resizebox{0.085\paperwidth}{!}{\usebox{\studio@graphic}}}%
  \fi
  \ifdim\dimexpr\ht\studio@graphic+\dp\studio@graphic\relax>0.12\paperheight
    \sbox{\studio@graphic}{\resizebox{!}{0.12\paperheight}{\usebox{\studio@graphic}}}%
  \fi
  \node[studio card,inner sep=0] (studio-card-\the\studio@cardcount) at (\studio@x,0) {\usebox{\studio@graphic}};
  \node[anchor=north,inner sep=0,text width=\dimexpr\studio@step\paperwidth-0.035\paperwidth\relax,
    align=center,text=bitpolito,font=\usebeamerfont{studio caption}] at (\studio@x,-0.15) {#2};
  \ifstudio@arrows\ifnum\studio@cardcount>1
    \pgfmathtruncatemacro{\studio@previous}{\the\studio@cardcount-1}%
    \draw[studio arrow,shorten <=9pt,shorten >=9pt]
      (studio-card-\studio@previous.east) -- (studio-card-\the\studio@cardcount.west);
  \fi\fi
}

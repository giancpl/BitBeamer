% Complete-frame helpers keep the theme's margins and typography in one place.
% The classic blue cover is the default. Optional catalogue variants share metadata.
\pgfkeys{/studio/cover/.is family,
  /studio/cover/variant/.is choice,
  /studio/cover/variant/pattern/.code=\def\studio@covervariant{pattern},
  /studio/cover/variant/classic/.style={/studio/cover/variant=pattern},
  /studio/cover/variant/wide-pattern/.code=\def\studio@covervariant{wide-pattern},
  /studio/cover/variant/bitgeneration/.style={/studio/cover/variant=wide-pattern},
  /studio/cover/variant/photo/.code=\def\studio@covervariant{photo},
  /studio/cover/variant/bitgeneration-photo/.style={/studio/cover/variant=photo}}
\newcommand{\studio@cataloguecover}[1]{%
  \@ifpackageloaded{bitpolitostudiotemplates}{%
    \ifcsname studio@choice@cover@#1@light\endcsname
      \studiotemplate[variant=#1,palette=light,title={\inserttitle},
        author={\insertauthor},institute={\insertinstitute}]{cover}%
    \else
      \PackageError{bitpolito-studio}{Cover variant '#1' is not included in this project}%
        {Include this cover variant and its prepared artwork. The classic blue cover is always available.}%
    \fi
  }{%
    \PackageError{bitpolito-studio}{Optional cover variants require bitpolitostudiotemplates}%
      {Load bitpolitostudiotemplates in the preamble. The classic blue cover needs only the Studio theme.}%
  }%
}
\newcommand{\studiotitleframe}[1][]{%
  \begingroup

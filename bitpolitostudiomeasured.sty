\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bitpolitostudiomeasured}[2026/10/31 Source-coordinate Studio layouts]
\RequirePackage{graphicx,tikz}
\usetikzlibrary{arrows.meta}
\RequirePackage{fancyvrb}
\urlstyle{same}
\providecommand{\studiopartpath}{images/studio/parts}
\newcommand{\studiopart}[2][width=2cm]{%
  \IfFileExists{\studiopartpath/#2.pdf}{%
    \includegraphics[#1,keepaspectratio]{\studiopartpath/#2.pdf}%
  }{\IfFileExists{images/studio/collection/#2.pdf}{\includegraphics[#1,keepaspectratio]{images/studio/collection/#2.pdf}}{\PackageError{bitpolitostudiomeasured}{Missing Studio part '#2'}{Restore the prepared PDF from the repository.}}}%
}
\newdimen\studiounit
\newdimen\studiofitunit
\newdimen\studiooffsetx
\newdimen\studiooffsety
\newbox\studiotextbox
\newif\ifstudiogeometryonly
\newif\ifstudioreviewdiagnostics
% All coordinates, font sizes and strokes use the same source unit.
% Source origin is the upper left. The tiny 16:9 discrepancy is centered.
\newcommand{\studiomeasuredcanvas}[5]{%
 \begingroup
 \def\studiopilotname{#3}%
 \studiounit=\dimexpr\paperwidth/#1\relax
 \studiofitunit=\dimexpr\paperheight/#2\relax
 \ifdim\studiofitunit<\studiounit\studiounit=\studiofitunit\fi
 \studiooffsetx=\dimexpr(\paperwidth-#1\studiounit)/2\relax
 \studiooffsety=\dimexpr(\paperheight-#2\studiounit)/2\relax
 \begin{frame}[plain]
 \begin{tikzpicture}[remember picture,overlay]
 \fill[#4] (current page.south west) rectangle (current page.north east);
 \begin{scope}[shift={([xshift=\studiooffsetx,yshift=-\studiooffsety]current page.north west)},
  x=\studiounit,y=-\studiounit,every node/.style={inner sep=0,outer sep=0},text=bitpolito]
 \clip (0,0) rectangle (#1,#2);
 #5
 \end{scope}
 \end{tikzpicture}
 \end{frame}
 \endgroup
}
% field, x, y, width, height, font size, leading, formatting, text.
% A fixed box never silently scales text. Empty fields are supported.
\newcommand{\studiomeasuredtext}[9]{%
 \ifstudiogeometryonly\else
 \typeout{STUDIO-FIELD: \studiopilotname/#1}%
 \node[anchor=north west] at (#2,#3) {\setbox\studiotextbox=\vbox{\hsize=#4\studiounit\parindent=0pt
  \hfuzz=\dimexpr\paperheight/400\relax\overfullrule=2pt\raggedright
  \normalfont\sffamily\fontsize{#6\studiounit}{#7\studiounit}\selectfont #8\noindent #9\par}%
 \ifdim\dimexpr\ht\studiotextbox+\dp\studiotextbox\relax>#5\studiounit
  \ifstudioreviewdiagnostics\PackageWarning{bitpolitostudiomeasured}{Text overflow in \studiopilotname/#1}%
  \else\PackageError{bitpolitostudiomeasured}{Text overflow in \studiopilotname/#1}{Shorten the text. The measured layout does not shrink fonts.}\fi%
 \fi
 \box\studiotextbox};%
 \fi
}
\newcommand{\studiomeasuredpart}[4]{%
 \node[anchor=north west] at (#2,#3) {\studiopart[width=#4\studiounit]{#1}};%
}

\providecommand{\studiotemplatedefaults}{}
\providecommand{\studiotemplateoptions}{}
\providecommand{\studiocurrenttemplate}{custom}
\pgfkeys{/studio fields/.is family,/studio fields/.unknown/.code={%
 \PackageError{bitpolitostudiomeasured}{Unknown field '\pgfkeyscurrentname' in \studiocurrenttemplate}{Use the fields documented for this model.}}}
\newcommand{\studiodeclarefield}[2]{%
 \pgfkeys{/studio fields/#1/.code=\pgfkeyssetvalue{/studio values/#1}{##1}}%
 \pgfkeyssetvalue{/studio values/#1}{#2}%
}
\newcommand{\studiofield}[1]{\pgfkeysvalueof{/studio values/#1}}
\newcommand{\studio@applyoptions}[1]{\pgfqkeys{/studio fields}{#1}}
\newcommand{\studioapplyfields}{%
 \ifdefined\studio@prepareslots\studio@prepareslots\fi
 \expandafter\studio@applyoptions\expandafter{\studiotemplatedefaults}%
 \expandafter\studio@applyoptions\expandafter{\studiotemplateoptions}%
 % Clear shipped copy first, then restore every explicit option, independent of order.
 \ifdefined\studio@clearslots
  \studio@clearslots
  \expandafter\studio@applyoptions\expandafter{\studiotemplateoptions}%
 \fi
}
\newbox\studiographicbox
\newcommand{\studiographfield}[7]{%
 \node[anchor=center] at ({#2+#4/2},{#3+#5/2}) {%
 \setbox\studiographicbox=\hbox{\normalfont\sffamily\studiofield{#1}}%
 \ifdim\wd\studiographicbox>\dimexpr#4\studiounit+.1pt\relax
  \PackageError{bitpolitostudiomeasured}{Graphic overflow in \studiopilotname/#1}{Keep the replacement within its documented slot width.}%
 \fi
 \ifdim\dimexpr\ht\studiographicbox+\dp\studiographicbox\relax>\dimexpr#5\studiounit+.1pt\relax
  \PackageError{bitpolitostudiomeasured}{Graphic overflow in \studiopilotname/#1}{Keep the replacement within its documented slot height.}%
 \fi
 \box\studiographicbox};%
}
\newcommand{\studiopilotcanvas}[3]{\studiomeasuredcanvas{3556}{2000}{#1}{#2}{#3}}
\let\studiopilottext\studiomeasuredtext
\let\studiopilotpart\studiomeasuredpart
\endinput

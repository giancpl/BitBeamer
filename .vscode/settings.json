{
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build/%RELATIVE_DIR%",
  "latex-workshop.latex.recipe.default": "lastUsed",
  "latex-workshop.latex.tools": [
    {
      "name": "bitbeamer-native",
      "command": "python3",
      "args": [
        "%WORKSPACE_FOLDER%/scripts/build.py",
        "%DOC_EXT%",
        "%OUTDIR%",
        "--open",
        "--backend",
        "native"
      ]
    },
    {
      "name": "bitbeamer-native-windows",
      "command": "py",
      "args": [
        "-3",
        "%WORKSPACE_FOLDER%/scripts/build.py",
        "%DOC_EXT%",
        "%OUTDIR%",
        "--open",
        "--backend",
        "native"
      ]
    },
    {
      "name": "bitbeamer-docker",
      "command": "python3",
      "args": [
        "%WORKSPACE_FOLDER%/scripts/build.py",
        "%DOC_EXT%",
        "%OUTDIR%",
        "--open",
        "--backend",
        "docker"
      ]
    },
    {
      "name": "bitbeamer-docker-windows",
      "command": "py",
      "args": [
        "-3",
        "%WORKSPACE_FOLDER%/scripts/build.py",
        "%DOC_EXT%",
        "%OUTDIR%",
        "--open",
        "--backend",
        "docker"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "BitBeamer: Docker",
      "tools": [
        "bitbeamer-docker"
      ]
    },
    {
      "name": "BitBeamer: Docker — Windows",
      "tools": [
        "bitbeamer-docker-windows"
      ]
    },
    {
      "name": "BitBeamer: native TeX Live",
      "tools": [
        "bitbeamer-native"
      ]
    },
    {
      "name": "BitBeamer: native TeX Live — Windows",
      "tools": [
        "bitbeamer-native-windows"
      ]
    }
  ],
  "search.exclude": {
    "**/build/**": true,
    "**/dist/**": true,
    "**/design-references/figma/**": true,
    "**/__pycache__/**": true
  },
  "files.exclude": {
    "**/__pycache__": true
  },
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.autoBuild.interval": 0,
  "latex-workshop.latex.build.enableMagicComments": true,
  "latex-workshop.view.pdf.viewer": "tab",
  "workbench.editorAssociations": {
    "*.pdf": "latex-workshop-pdf-hook"
  },
  "workbench.editor.revealIfOpen": true
}

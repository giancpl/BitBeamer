{
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build",
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.tools": [
    {
      "name": "bitbeamer-native",
      "command": "python3",
      "args": [
        "%WORKSPACE_FOLDER%/scripts/build.py",
        "%DOC%",
        "%OUTDIR%",
        "--backend",
        "native"
      ]
    },
    {
      "name": "bitbeamer-native-windows",
      "command": "py",
      "args": [
        "-3",
        "%WORKSPACE_FOLDER%/scripts/build.py",
        "%DOC%",
        "%OUTDIR%",
        "--backend",
        "native"
      ]
    },
    {
      "name": "bitbeamer-docker",
      "command": "python3",
      "args": [
        "%WORKSPACE_FOLDER%/scripts/build.py",
        "%DOC%",
        "%OUTDIR%",
        "--backend",
        "docker"
      ]
    },
    {
      "name": "bitbeamer-docker-windows",
      "command": "py",
      "args": [
        "-3",
        "%WORKSPACE_FOLDER%/scripts/build.py",
        "%DOC%",
        "%OUTDIR%",
        "--backend",
        "docker"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "BitBeamer: Docker",
      "tools": [
        "bitbeamer-docker"
      ]
    },
    {
      "name": "BitBeamer: Docker \u2014 Windows",
      "tools": [
        "bitbeamer-docker-windows"
      ]
    },
    {
      "name": "BitBeamer: native TeX Live",
      "tools": [
        "bitbeamer-native"
      ]
    },
    {
      "name": "BitBeamer: native TeX Live \u2014 Windows",
      "tools": [
        "bitbeamer-native-windows"
      ]
    }
  ]
}

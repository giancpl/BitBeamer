      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "BitBeamer: check native setup",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/build.py",
        "--backend",
        "native",
        "--setup"
      ],
      "windows": {
        "command": "py",
        "args": [
          "-3",
          "${workspaceFolder}/scripts/build.py",
          "--backend",
          "native",
          "--setup"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}

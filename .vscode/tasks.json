{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BitBeamer: build presentation",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/build.py"
      ],
      "windows": {
        "command": "py",
        "args": [
          "-3",
          "${workspaceFolder}/scripts/build.py"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "BitBeamer: preview illustrations",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/build.py",
        "examples/assets-example.tex"
      ],
      "windows": {
        "command": "py",
        "args": [
          "-3",
          "${workspaceFolder}/scripts/build.py",
          "examples/assets-example.tex"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "BitBeamer: build asset catalogue",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/build.py",
        "examples/asset-catalogue.tex"
      ],
      "windows": {
        "command": "py",
        "args": [
          "-3",
          "${workspaceFolder}/scripts/build.py",
          "examples/asset-catalogue.tex"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "BitBeamer: build with native TeX Live",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/build.py",
        "--backend",
        "native"
      ],
      "windows": {
        "command": "py",
        "args": [
          "-3",
          "${workspaceFolder}/scripts/build.py",
          "--backend",
          "native"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "BitBeamer: prepare Docker compiler",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/build.py",
        "--setup"
      ],
      "windows": {
        "command": "py",
        "args": [
          "-3",
          "${workspaceFolder}/scripts/build.py",
          "--setup"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "BitBeamer: build icon cheat sheet",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/build.py",
        "examples/icon-cheatsheet.tex"

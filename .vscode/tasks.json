{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BitBeamer Academic: build presentation (default)",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/build.py"
      ],
      "windows": {
        "command": "py",
        "args": [
          "-3",
          "${workspaceFolder}/scripts/build.py"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "BitBeamer: preview illustrations",
      "type": "process",
      "command": "python3",
      "args": [

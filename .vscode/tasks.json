        "command": "py",
        "args": [
          "-3",
          "${workspaceFolder}/scripts/build.py",
          "examples/icon-cheatsheet.tex"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "BitBeamer: check documentation",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/check-docs.py"
      ],
      "windows": {
        "command": "py",
        "args": [
          "-3",
          "${workspaceFolder}/scripts/check-docs.py"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "BitBeamer: preview both covers",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/build.py",
        "examples/cover-layouts.tex"
      ],
      "windows": {

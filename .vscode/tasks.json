  "inputs": [
    {
      "id": "studioModel",
      "type": "promptString",
      "description": "Studio model ID (see the slide guide)",
      "default": "three-cards"
    },
    {
      "id": "deckName",
      "type": "promptString",
      "description": "Personal presentation name (lowercase kebab-case)",
      "default": "my-talk"
    },
    {
      "id": "deckStyle",
      "type": "pickString",
      "description": "Presentation design",
      "options": [
        "studio",
        "academic"
      ],
      "default": "studio"
    },
    {
      "id": "deckBackend",
      "type": "pickString",
      "description": "Compiler backend",
      "options": [
        "docker",
        "native"
      ],
      "default": "docker"
    },
    {
      "id": "lessonId",
      "type": "promptString",
      "description": "Official lesson ID",
      "default": "bitcoin-introduction-short"
    },
    {
      "id": "blockId",
      "type": "promptString",
      "description": "Reusable lesson block ID",
      "default": "hashing"
    }

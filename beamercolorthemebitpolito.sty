% ======================
% COLOR THEME
% ======================
\definecolor{bitpolito}{HTML}{001CE0}
\definecolor{bitpolito-light}{HTML}{EEF0FF}
\definecolor{bitpolito-ink}{HTML}{10163A}
\definecolor{bitpolito-muted}{HTML}{536080}

% Semantic accents use the BitPolito blue/lilac palette.
\colorlet{bitpolito-green}{bitpolito}
\definecolor{bitpolito-orange}{HTML}{8090FF}
\colorlet{bitpolito-red}{bitpolito-ink}

\setbeamercolor{background canvas}{bg=white}
\setbeamercolor{normal text}{fg=bitpolito-ink,bg=white}
\setbeamercolor{structure}{fg=bitpolito}
\setbeamercolor{block}{bg=bitpolito}
\setbeamercolor{titlelike}{fg=bitpolito}
\setbeamercolor{framesubtitle}{fg=bitpolito-muted}
\setbeamercolor{subtitle}{fg=bitpolito-muted}
\setbeamercolor{alerted text}{fg=bitpolito-red}
\setbeamercolor{example text}{fg=bitpolito-green}
\setbeamercolor{palette primary}{fg=white, bg=bitpolito}
\setbeamercolor{palette secondary}{fg=white, bg=bitpolito}
\setbeamercolor{palette tertiary}{fg=white, bg=bitpolito}
\setbeamercolor{palette quaternary}{fg=white, bg=bitpolito}
\setbeamercolor{block title}{fg=white,bg=bitpolito}
\setbeamercolor{block body}{fg=bitpolito-ink,bg=bitpolito-light}
\setbeamercolor{block title alerted}{fg=white,bg=bitpolito-red}
\setbeamercolor{block body alerted}{fg=bitpolito-ink,bg=bitpolito-light}
\setbeamercolor{block title example}{fg=white,bg=bitpolito-green}
\setbeamercolor{block body example}{fg=bitpolito-ink,bg=bitpolito-light}

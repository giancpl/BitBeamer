\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bitpolitostudiolayouts}[2026/10/31 Additional editable Studio layouts]
% This optional library does not change either theme's defaults.
\usetikzlibrary{calc,positioning,decorations.pathreplacing,shapes.callouts}
\newlength{\studio@tilewidth}\setlength{\studio@tilewidth}{0.19\paperwidth}
\tikzset{studio tile/.style={rounded corners=7pt,fill=studio-paper,draw=white,
    line width=0.4pt,inner sep=8pt,align=left,text=bitpolito,
    blur shadow={shadow xshift=0pt,shadow yshift=-2pt,shadow blur steps=12,
      shadow blur radius=3pt,shadow opacity=10}},
  studio outline/.style={draw=bitpolito,rounded corners=4pt,line width=0.6pt,
    text=bitpolito,align=center,inner sep=5pt},
  studio small label/.style={font=\scriptsize,align=center,inner sep=2pt},
  studio diagram text/.style={font=\small,align=center,text=bitpolito},
  studio path/.style={draw=bitpolito,line width=0.7pt},
  studio white path/.style={draw=white,line width=0.7pt}}
% Normalized coordinates: (0,0) is the lower-left slide corner; (1,1) is upper-right.
% The canvas owns a complete frame. Use it outside any surrounding frame.
\newcommand{\studiocanvas}[2][light]{%
  \begingroup
  \def\studio@background{#1}\def\studio@blue{blue}%
  \ifx\studio@background\studio@blue
    \def\studioforeground{white}\def\studiobackground{bitpolito}%
  \else
    \def\studioforeground{bitpolito}\def\studiobackground{studio-paper}%
  \fi
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture,overlay,x=\paperwidth,y=\paperheight,
      shift={(current page.south west)},text=\studioforeground,
      every node/.style={inner sep=0,align=center,font=\small}]
      \fill[\studiobackground] (0,0) rectangle (1,1);
      #2
    \end{tikzpicture}%
  \end{frame}%
  \endgroup
}
\colorlet{studio-glow-middle}{bitpolito!45!studio-paper}
\pgfdeclareradialshading{studio glow}{\pgfpoint{0bp}{0bp}}{%
  color(0bp)=(bitpolito);color(10bp)=(bitpolito);
  color(18bp)=(studio-glow-middle);color(25bp)=(studio-paper)}
\newcommand{\studioglowframe}[1]{%
  \studiocanvas{%
    \shade[shading=studio glow] (0.5,0.5) ellipse [x radius=0.33\paperwidth,y radius=0.48\paperheight];
    \node[text=white,text width=0.40\paperwidth,font=\usebeamerfont{studio statement}]
      at (0.5,0.5) {#1};}%
}
\newcount\studio@railcount
\newcommand{\studiorailframe}[3][light]{%
  \studiocanvas[#1]{%
    \node[anchor=west,align=left,text width=0.33\paperwidth,
      font=\usebeamerfont{frametitle}] at (0.07,0.5) {#2};
    \draw[draw=\studioforeground,line width=0.7pt] (0.49,0.12) -- (0.49,0.88);
    \studio@railcount=0 #3
  }%
}
\newcommand{\studiorailitem}[2]{%
  \advance\studio@railcount by 1
  \ifnum\studio@railcount>5
    \PackageError{bitpolito-studio}{Too many rail items}{Use at most five items or split the slide.}%
  \fi
  \pgfmathsetmacro{\studio@raily}{0.82-(\the\studio@railcount-1)*0.15}%
  \fill[\studioforeground] (0.49,\studio@raily) circle[radius=1.4pt];
  \node[anchor=north west,align=left,text width=0.40\paperwidth]
    at (0.525,\studio@raily+0.018) {{\bfseries #1}\par\smallskip{\scriptsize #2}};
}
\newcommand{\studiosidebysideframe}[4]{%
  \studiocanvas{%
    \fill[bitpolito] (0.5,0) rectangle (1,1);
    \node[anchor=north west,align=left,text width=0.35\paperwidth,
      font=\usebeamerfont{frametitle}] at (0.07,0.84) {#1};
    \node[anchor=north west,align=left,text width=0.35\paperwidth]
      at (0.07,0.62) {\raggedright #2};
    \node[anchor=north west,align=left,text=white,text width=0.35\paperwidth,
      font=\usebeamerfont{frametitle}] at (0.57,0.84) {#3};
    \node[anchor=north west,align=left,text=white,text width=0.35\paperwidth]
      at (0.57,0.62) {\color{white}\raggedright #4};}%
}
\newcommand{\studioquotecardframe}[2]{%
  \studiocanvas[blue]{%
    \node[studio tile,fill=white,draw=none,rounded corners=9pt,
      text width=0.60\paperwidth,inner sep=16pt] at (0.5,0.5)
      {{\large #1\par}\bigskip{\scriptsize #2}};}%
}
\newcommand{\studiospotlightframe}[3][light]{%
  \studiocanvas[#1]{%
    \node at (0.5,0.61) {\studiofitgraphic{0.3\paperwidth}{0.25\paperheight}{#2}};
    \node[text width=0.68\paperwidth,font=\usebeamerfont{studio statement}]
      at (0.5,0.35) {#3};}%
}
\endinput
